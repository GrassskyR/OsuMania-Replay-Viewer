<?xml version="1.0" encoding="utf-8"?>
<!--
  This machine cannot reach nuget.org: the .NET HTTP stack fails the TLS revocation check
  (CRYPT_E_REVOCATION_OFFLINE) against the local proxy, so any remote feed defined here makes
  `dotnet restore` fail with NU1301.

  The committed `packages/` directory is therefore the only configured source. It holds the
  .nupkg files this solution needs (SharpCompress, ZstdSharp.Port, xunit and the .NET test SDK).
  To add a package, download its .nupkg with curl (using its ssl-no-revoke option) into
  `packages/` and reference it by exact pinned version.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="local" value="packages" />
  </packageSources>
</configuration>
