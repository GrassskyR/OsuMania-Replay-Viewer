<Window x:Class="ManiaReplayMaster.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ManiaReplayMaster.App.Localization"
        Title="Mania Replay Viewer" Height="820" Width="1080"
        MinHeight="640" MinWidth="880"
        AllowDrop="True"
        Background="#FF1E1E1E"
        Foreground="{StaticResource TextPrimary}"
        Drop="OnDrop" DragOver="OnDragOver"
        Closing="OnClosing">

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header + game status -->
    <DockPanel Grid.Row="0" LastChildFill="False">
      <TextBlock DockPanel.Dock="Left" Text="Mania Replay Viewer" FontSize="20" FontWeight="Bold" />
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="{loc:Text Language.Label}" Style="{StaticResource Label}" Margin="0,0,8,0" />
        <ComboBox x:Name="LanguageBox" Width="140" Margin="0,0,12,0"
                  SelectedValuePath="Tag" SelectedValue="{Binding Preference, Source={x:Static loc:Localizer.Current}}"
                  ToolTip="{loc:Text Language.Tooltip}">
          <ComboBoxItem Tag="auto" Content="{loc:Text Language.System}" />
          <ComboBoxItem Tag="zh-Hans" Content="中文" />
          <ComboBoxItem Tag="en" Content="English" />
        </ComboBox>
        <Border Background="{StaticResource ControlBackground}" BorderBrush="{StaticResource ControlBorder}"
                BorderThickness="1" CornerRadius="3" Padding="10,5">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="7" Height="7" Fill="{Binding GamePillBrush}" Margin="0,0,7,0" />
            <TextBlock x:Name="GameStatusLabel" Text="{Binding GameStatusText}" FontSize="12" />
          </StackPanel>
        </Border>
      </StackPanel>
    </DockPanel>

    <!-- Inputs -->
    <Border Grid.Row="1" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}"
            BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,12,0,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Text Replay.Label}" Style="{StaticResource Label}" />
        <TextBox x:Name="ReplayBox" Grid.Row="0" Grid.Column="1" Margin="0,0,6,4"
                 Text="{Binding ReplayPath, UpdateSourceTrigger=PropertyChanged}" />
        <Button Grid.Row="0" Grid.Column="2" Content="{loc:Text Browse}" Click="OnBrowseReplay" />
        <Button Grid.Row="0" Grid.Column="3" Content="{loc:Text Locate}" Click="OnLocateFromReplay"
                ToolTip="{loc:Text Locate.Tooltip}" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Text Beatmap.Label}" Style="{StaticResource Label}" />
        <TextBox x:Name="BeatmapBox" Grid.Row="1" Grid.Column="1" Margin="0,0,6,4"
                 Text="{Binding BeatmapPath, UpdateSourceTrigger=PropertyChanged}" />
        <Button Grid.Row="1" Grid.Column="2" Content="{loc:Text Browse}" Click="OnBrowseBeatmap" />
        <Button Grid.Row="1" Grid.Column="3" Content="{loc:Text Swap}" Click="OnSwapPaths"
                ToolTip="{loc:Text Swap.Tooltip}" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Text DetectedScore.Label}" Style="{StaticResource Label}" />
        <Border Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Background="#FF2D2D30" CornerRadius="3"
                Padding="8,5" Margin="0,2,0,4">
          <DockPanel LastChildFill="True">
            <ComboBox x:Name="ScoreCandidateBox" DockPanel.Dock="Right" Width="260" Margin="8,0,0,0"
                      DisplayMemberPath="Display" SelectionChanged="OnCandidateSelected"
                      ToolTip="{loc:Text Candidates.Tooltip}" />
            <TextBlock Text="{Binding DetectedScoreText}" TextTrimming="CharacterEllipsis" />
          </DockPanel>
        </Border>

        <WrapPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,8,0,0">
          <CheckBox x:Name="AutoDetectToggle" Content="{loc:Text AutoDetect}" IsChecked="{Binding AutoDetectFromGame}"
                    ToolTip="{loc:Text AutoDetect.Tooltip}" />
          <CheckBox Content="{loc:Text AutoStart}" IsChecked="{Binding AutoStartRender}"
                    ToolTip="{loc:Text AutoStart.Tooltip}" />
          <CheckBox Content="{loc:Text ReadMemory}" IsChecked="{Binding MemoryEnabled}"
                    ToolTip="{loc:Text ReadMemory.Tooltip}" />
          <CheckBox Content="{loc:Text DebugLogging}" IsChecked="{Binding DebugLogging}" />
        </WrapPanel>
      </Grid>
    </Border>

    <!-- Parameters -->
    <Border Grid.Row="2" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}"
            BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,8,0,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Text Speed}" Style="{StaticResource Label}" />
        <Slider x:Name="SpeedSlider" Grid.Row="0" Grid.Column="1" Minimum="1" Maximum="100"
                IsSnapToTickEnabled="True" TickFrequency="1" ToolTip="{loc:Text Speed.Tooltip}"
                Value="{Binding Speed}" ValueChanged="OnSpeedChanged" Margin="0,0,10,0" />
        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Speed}" Width="30" />

        <TextBlock Grid.Row="0" Grid.Column="3" Text="{loc:Text Width}" Style="{StaticResource Label}" />
        <TextBox x:Name="WidthBox" Grid.Row="0" Grid.Column="4" Width="60" Text="{Binding Width}" Margin="0,0,10,0" />

        <TextBlock Grid.Row="0" Grid.Column="5" Text="{loc:Text Height}" Style="{StaticResource Label}" />
        <TextBox x:Name="HeightBox" Grid.Row="0" Grid.Column="6" Width="60" Text="{Binding Height}" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Text FPS}" Style="{StaticResource Label}" Margin="0,6,8,0" />
        <TextBox x:Name="FpsBox" Grid.Row="1" Grid.Column="1" Width="60" HorizontalAlignment="Left" Margin="0,6,0,0"
                 Text="{Binding FramePerSecond}" />
        <TextBlock Grid.Row="1" Grid.Column="2" Text="{loc:Text Codec}" Style="{StaticResource Label}" Margin="0,6,8,0" />
        <ComboBox x:Name="CodecBox" Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" Margin="0,6,10,0"
                  IsEditable="True" ItemsSource="{Binding CodecChoices}" ToolTip="{loc:Text Codec.Tooltip}"
                  Text="{Binding Codec, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Grid.Row="1" Grid.Column="5" Text="{loc:Text Preset}" Style="{StaticResource Label}" Margin="0,6,8,0" />
        <ComboBox x:Name="PresetBox" Grid.Row="1" Grid.Column="6" Width="140" Margin="0,6,0,0"
                  ItemsSource="{Binding PresetChoices}" IsEnabled="{Binding CanSelectPreset}"
                  ToolTip="{loc:Text Preset.Tooltip}" ToolTipService.ShowOnDisabled="True"
                  SelectedItem="{Binding CodecPreset}" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Text Output}" Style="{StaticResource Label}" Margin="0,6,8,0" />
        <TextBox x:Name="OutputBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4" Margin="0,6,10,0" Text="{Binding OutputDir}" />
        <Button Grid.Row="2" Grid.Column="5" Grid.ColumnSpan="2" Content="{loc:Text OpenOutput}" Margin="0,6,0,0"
                Click="OnOpenOutputDir" />
      </Grid>
    </Border>

    <!-- Log -->
    <Border Grid.Row="3" Background="#FF141414" BorderBrush="{StaticResource PanelBorder}"
            BorderThickness="1" CornerRadius="4" Margin="0,8,0,0">
      <ListBox x:Name="LogBox" Background="Transparent" BorderThickness="0" Foreground="#FFCFCFCF"
               FontFamily="Consolas" FontSize="12"
               ScrollViewer.HorizontalScrollBarVisibility="Auto"
               ItemsSource="{Binding LogLines}" />
    </Border>

    <!-- Progress -->
    <Grid Grid.Row="4" Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ProgressBar Grid.Column="0" Height="18" Minimum="0" Maximum="100" Value="{Binding Progress}" />
      <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                 Text="{Binding ProgressText}" MinWidth="180" />
    </Grid>

    <!-- Actions -->
    <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,10,0,0">
      <Button x:Name="RenderButton" Content="{loc:Text Render}" Click="OnRender" IsEnabled="{Binding CanRender}" FontWeight="SemiBold" />
      <Button x:Name="JudgeOnlyButton" Content="{loc:Text JudgeOnly}" Click="OnJudgeOnly" IsEnabled="{Binding CanRender}"
              ToolTip="{loc:Text JudgeOnly.Tooltip}" />
      <Button x:Name="CancelButton" Content="{loc:Text Cancel}" Click="OnCancel" IsEnabled="{Binding IsBusy}" />
      <TextBlock x:Name="ResultText" VerticalAlignment="Center" Margin="12,0,0,0"
                 Text="{Binding ResultText}" />
    </StackPanel>
  </Grid>
</Window>
