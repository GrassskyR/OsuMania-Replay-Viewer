<Window x:Class="ManiaReplayMaster.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mania Replay Viewer" Height="820" Width="1080"
        MinHeight="640" MinWidth="880"
        AllowDrop="True"
        Background="#FF1E1E1E"
        Drop="OnDrop" DragOver="OnDragOver"
        Closing="OnClosing">

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header + game status -->
    <DockPanel Grid.Row="0" LastChildFill="False">
      <TextBlock DockPanel.Dock="Left" Text="Mania Replay Viewer" FontSize="20" FontWeight="Bold" />
      <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" Background="{Binding GamePillBrush}">
        <TextBlock Text="{Binding GameStatusText}" FontSize="12" />
      </Border>
    </DockPanel>

    <!-- Inputs -->
    <Border Grid.Row="1" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}"
            BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,12,0,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Replay (.osr / .mr)" Style="{StaticResource Label}" />
        <TextBox x:Name="ReplayBox" Grid.Row="0" Grid.Column="1" Margin="0,0,6,4"
                 Text="{Binding ReplayPath, UpdateSourceTrigger=PropertyChanged}" />
        <Button Grid.Row="0" Grid.Column="2" Content="Browse" Click="OnBrowseReplay" />
        <Button Grid.Row="0" Grid.Column="3" Content="Locate" Click="OnLocateFromReplay"
                ToolTip="Resolve the beatmap for this replay by its MD5" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Beatmap (.osu / .osz / .mc)" Style="{StaticResource Label}" />
        <TextBox x:Name="BeatmapBox" Grid.Row="1" Grid.Column="1" Margin="0,0,6,4"
                 Text="{Binding BeatmapPath, UpdateSourceTrigger=PropertyChanged}" />
        <Button Grid.Row="1" Grid.Column="2" Content="Browse" Click="OnBrowseBeatmap" />
        <Button Grid.Row="1" Grid.Column="3" Content="Swap" Click="OnSwapPaths"
                ToolTip="Swap which box holds the replay and the beatmap" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Detected score" Style="{StaticResource Label}" />
        <Border Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Background="#FF2D2D30" CornerRadius="3"
                Padding="8,5" Margin="0,2,0,4">
          <DockPanel LastChildFill="True">
            <ComboBox x:Name="ScoreCandidateBox" DockPanel.Dock="Right" Width="260" Margin="8,0,0,0"
                      DisplayMemberPath="Display" SelectionChanged="OnCandidateSelected"
                      ToolTip="Other candidate replays for this beatmap" />
            <TextBlock Text="{Binding DetectedScoreText}" TextTrimming="CharacterEllipsis" />
          </DockPanel>
        </Border>

        <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,4,0,0">
          <CheckBox Content="Auto-detect from osu!" IsChecked="{Binding AutoDetectFromGame}" />
          <CheckBox Content="Auto-start render" IsChecked="{Binding AutoStartRender}"
                    ToolTip="Off by default to avoid surprise renders" />
          <CheckBox Content="Read process memory" IsChecked="{Binding MemoryEnabled}" />
          <CheckBox Content="Debug logging" IsChecked="{Binding DebugLogging}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Parameters -->
    <Border Grid.Row="2" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}"
            BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,8,0,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Speed" Style="{StaticResource Label}" />
        <Slider x:Name="SpeedSlider" Grid.Row="0" Grid.Column="1" Minimum="1" Maximum="100"
                IsSnapToTickEnabled="True" TickFrequency="1"
                Value="{Binding Speed}" ValueChanged="OnSpeedChanged" Margin="0,0,10,0" />
        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Speed}" Width="30" />

        <TextBlock Grid.Row="0" Grid.Column="3" Text="Width" Style="{StaticResource Label}" />
        <TextBox x:Name="WidthBox" Grid.Row="0" Grid.Column="4" Width="60" Text="{Binding Width}" Margin="0,0,10,0" />

        <TextBlock Grid.Row="0" Grid.Column="5" Text="Height" Style="{StaticResource Label}" />
        <TextBox x:Name="HeightBox" Grid.Row="0" Grid.Column="6" Width="60" Text="{Binding Height}" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="FPS" Style="{StaticResource Label}" Margin="0,6,8,0" />
        <TextBox x:Name="FpsBox" Grid.Row="1" Grid.Column="1" Width="60" HorizontalAlignment="Left" Margin="0,6,0,0"
                 Text="{Binding FramePerSecond}" />
        <TextBlock Grid.Row="1" Grid.Column="2" Text="Codec" Style="{StaticResource Label}" Margin="0,6,8,0" />
        <TextBox Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" Margin="0,6,10,0" Text="{Binding Codec}" />
        <TextBlock Grid.Row="1" Grid.Column="5" Text="Preset" Style="{StaticResource Label}" Margin="0,6,8,0" />
        <TextBox Grid.Row="1" Grid.Column="6" Width="90" Margin="0,6,0,0" Text="{Binding CodecPreset}" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Output" Style="{StaticResource Label}" Margin="0,6,8,0" />
        <TextBox x:Name="OutputBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4" Margin="0,6,10,0" Text="{Binding OutputDir}" />
        <Button Grid.Row="2" Grid.Column="5" Grid.ColumnSpan="2" Content="Open output folder" Margin="0,6,0,0"
                Click="OnOpenOutputDir" />
      </Grid>
    </Border>

    <!-- Log -->
    <Border Grid.Row="3" Background="#FF141414" BorderBrush="{StaticResource PanelBorder}"
            BorderThickness="1" CornerRadius="4" Margin="0,8,0,0">
      <ListBox x:Name="LogBox" Background="Transparent" BorderThickness="0" Foreground="#FFCFCFCF"
               FontFamily="Consolas" FontSize="12"
               ScrollViewer.HorizontalScrollBarVisibility="Auto"
               ItemsSource="{Binding LogLines}" />
    </Border>

    <!-- Progress -->
    <Grid Grid.Row="4" Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ProgressBar Grid.Column="0" Height="18" Minimum="0" Maximum="100" Value="{Binding Progress}" />
      <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                 Text="{Binding ProgressText}" MinWidth="180" />
    </Grid>

    <!-- Actions -->
    <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,10,0,0">
      <Button Content="Render" Click="OnRender" IsEnabled="{Binding CanRender}" FontWeight="SemiBold" />
      <Button Content="Judge only" Click="OnJudgeOnly" IsEnabled="{Binding CanRender}" />
      <Button Content="Cancel" Click="OnCancel" IsEnabled="{Binding IsBusy}" />
      <TextBlock x:Name="ResultText" VerticalAlignment="Center" Margin="12,0,0,0"
                 Text="{Binding ResultText}" />
    </StackPanel>
  </Grid>
</Window>
