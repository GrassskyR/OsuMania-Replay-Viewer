<Application x:Class="ManiaReplayMaster.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>

    <SolidColorBrush x:Key="PanelBackground" Color="#FF252526" />
    <SolidColorBrush x:Key="PanelBorder" Color="#FF3F3F46" />
    <SolidColorBrush x:Key="PillOk" Color="#FF2E7D32" />
    <SolidColorBrush x:Key="PillWarn" Color="#FF8D6E00" />
    <SolidColorBrush x:Key="PillOff" Color="#FF555558" />

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#FFEEEEEE" />
    </Style>

    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#FFB0B0B0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <Style x:Key="SectionHeader" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#FFFFD237" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,12,0,6" />
    </Style>

    <Style x:Key="Pill" TargetType="Border">
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="Background" Value="{StaticResource PillOff}" />
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#FF1E1E1E" />
      <Setter Property="Foreground" Value="#FFEEEEEE" />
      <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
      <Setter Property="Padding" Value="4,3" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="MinWidth" Value="72" />
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#FFEEEEEE" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,14,0" />
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Padding" Value="4,3" />
    </Style>

  </Application.Resources>
</Application>
