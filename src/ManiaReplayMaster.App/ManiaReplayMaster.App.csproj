<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ManiaReplayMaster.App</RootNamespace>
    <AssemblyName>ManiaReplayMaster</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ManiaReplayMaster.Core\ManiaReplayMaster.Core.csproj" />
    <ProjectReference Include="..\ManiaReplayMaster.Render\ManiaReplayMaster.Render.csproj" />
    <ProjectReference Include="..\ManiaReplayMaster.Encode\ManiaReplayMaster.Encode.csproj" />
    <ProjectReference Include="..\ManiaReplayMaster.Game\ManiaReplayMaster.Game.csproj" />
  </ItemGroup>

</Project>
