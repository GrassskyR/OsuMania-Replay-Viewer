<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ManiaReplayMaster.Desktop.App" RequestedThemeVariant="Dark">
  <Application.Resources>
    <SolidColorBrush x:Key="PanelBackground" Color="#252526" />
    <SolidColorBrush x:Key="PanelBorder" Color="#3F3F46" />
    <SolidColorBrush x:Key="TextPrimary" Color="#F4F4F5" />
    <SolidColorBrush x:Key="TextSecondary" Color="#DDDEE3" />
    <SolidColorBrush x:Key="ControlBackground" Color="#34343A" />
    <SolidColorBrush x:Key="ControlBorder" Color="#777780" />
  </Application.Resources>
  <Application.Styles>
    <FluentTheme DensityStyle="Compact" />
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style Selector="Button">
      <Setter Property="Height" Value="26" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="MinWidth" Value="60" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="Margin" Value="0,0,12,2" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="Height" Value="26" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Height" Value="26" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="AutoCompleteBox">
      <Setter Property="Height" Value="26" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Padding" Value="6,2" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Padding" Value="8,2" />
    </Style>
    <Style Selector="Slider">
      <Setter Property="Height" Value="26" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Application.Styles>
</Application>
