<Window x:Class="ManiaReplayMaster.Desktop.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ManiaReplayMaster.Presentation"
        x:DataType="vm:MainViewModel" x:CompileBindings="True"
        Title="Mania Replay Viewer" Height="680" Width="960"
        MinHeight="360" MinWidth="560"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True"
        DragDrop.AllowDrop="True"
        Background="#FF1E1E1E"
        Foreground="{StaticResource TextPrimary}">

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header + game status -->
    <WrapPanel Grid.Row="0">
      <TextBlock Text="Mania Replay Viewer" FontSize="20" FontWeight="Bold" Margin="0,0,20,6" VerticalAlignment="Center" />
      <WrapPanel VerticalAlignment="Center">
        <TextBlock Text="{Binding L[Language.Label]}" Classes="label" Margin="0,0,8,0" />
        <ComboBox x:Name="LanguageBox" AutomationProperties.AutomationId="LanguageBox" Width="120" Margin="0,0,12,6"
                  SelectedIndex="0"
                  ToolTip.Tip="{Binding L[Language.Tooltip]}">
          <ComboBoxItem Tag="auto" Content="{Binding L[Language.System]}" />
          <ComboBoxItem Tag="zh-Hans" Content="中文" />
          <ComboBoxItem Tag="en" Content="English" />
        </ComboBox>
        <Border Background="{StaticResource ControlBackground}" BorderBrush="{StaticResource ControlBorder}"
                BorderThickness="1" CornerRadius="3" Padding="10,5" Margin="0,0,0,6" Height="32">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="7" Height="7" Fill="{Binding GamePillBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
            <TextBlock x:Name="GameStatusLabel" AutomationProperties.AutomationId="GameStatusLabel" Text="{Binding GameStatusText}" FontSize="12" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
      </WrapPanel>
    </WrapPanel>

    <ScrollViewer x:Name="ContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <Grid x:Name="ContentGrid">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Inputs -->
        <Border x:Name="InputsPanel" Grid.Row="0" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,4,0,0">
          <Grid RowSpacing="4">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding L[Replay.Label]}" Classes="label" />
            <TextBox x:Name="ReplayBox" AutomationProperties.AutomationId="ReplayBox" Grid.Row="0" Grid.Column="1" Margin="0,0,6,0"
                     Text="{Binding ReplayPath, Mode=TwoWay}" />
            <Button x:Name="BrowseReplayButton" AutomationProperties.AutomationId="BrowseReplayButton" Grid.Row="0" Grid.Column="2" Content="{Binding L[Browse]}" Click="OnBrowseReplay" />
            <Button Grid.Row="0" Grid.Column="3" AutomationProperties.AutomationId="LocateButton" Content="{Binding L[Locate]}" Click="OnLocateFromReplay" Margin="0"
                    ToolTip.Tip="{Binding L[Locate.Tooltip]}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding L[Beatmap.Label]}" Classes="label" />
            <TextBox x:Name="BeatmapBox" AutomationProperties.AutomationId="BeatmapBox" Grid.Row="1" Grid.Column="1" Margin="0,0,6,0"
                     Text="{Binding BeatmapPath, Mode=TwoWay}" />
            <Button x:Name="BrowseBeatmapButton" AutomationProperties.AutomationId="BrowseBeatmapButton" Grid.Row="1" Grid.Column="2" Content="{Binding L[Browse]}" Click="OnBrowseBeatmap" />
            <Button Grid.Row="1" Grid.Column="3" AutomationProperties.AutomationId="SwapButton" Content="{Binding L[Swap]}" Click="OnSwapPaths" Margin="0"
                    ToolTip.Tip="{Binding L[Swap.Tooltip]}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding L[DetectedScore.Label]}" Classes="label" />
            <Border Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Background="#FF2D2D30" CornerRadius="3"
                    Padding="8,5" Margin="0,2,0,4">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <ComboBox x:Name="ScoreCandidateBox" AutomationProperties.AutomationId="ScoreCandidateBox" Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" Margin="8,0,0,0"
                           SelectionChanged="OnCandidateSelected"
                          ToolTip.Tip="{Binding L[Candidates.Tooltip]}">
                  <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:CandidateItem"><TextBlock Text="{Binding Display}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{Binding DetectedScoreText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              </Grid>
            </Border>

            <WrapPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,8,0,0">
              <CheckBox x:Name="AutoDetectToggle" AutomationProperties.AutomationId="AutoDetectToggle" Content="{Binding L[AutoDetect]}" IsChecked="{Binding AutoDetectFromGame, Mode=TwoWay}"
                        ToolTip.Tip="{Binding L[AutoDetect.Tooltip]}" />
              <CheckBox Content="{Binding L[AutoStart]}" IsChecked="{Binding AutoStartRender, Mode=TwoWay}"
                        ToolTip.Tip="{Binding L[AutoStart.Tooltip]}" />
              <CheckBox Content="{Binding L[ReadMemory]}" IsChecked="{Binding MemoryEnabled, Mode=TwoWay}"
                        ToolTip.Tip="{Binding L[ReadMemory.Tooltip]}" />
              <CheckBox Content="{Binding L[DebugLogging]}" IsChecked="{Binding DebugLogging, Mode=TwoWay}" />
            </WrapPanel>
          </Grid>
        </Border>

        <!-- Parameters -->
        <Border x:Name="ParametersPanel" Grid.Row="1" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,8,0,0">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <WrapPanel Grid.ColumnSpan="3">
            <Grid Width="252" Margin="0,0,12,6">
              <Grid.ColumnDefinitions><ColumnDefinition Width="82" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding L[Speed]}" Classes="label" />
              <Grid Grid.Column="1"><Slider Margin="0,0,32,0" x:Name="SpeedSlider" AutomationProperties.AutomationId="SpeedSlider" Minimum="1" Maximum="100"
                      IsSnapToTickEnabled="True" TickFrequency="1" ToolTip.Tip="{Binding L[Speed.Tooltip]}"
                      Value="{Binding Speed, Mode=TwoWay}" />
                <TextBlock Text="{Binding Speed}" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
            </Grid>
            <Grid Width="252" Margin="0,0,12,6">
              <Grid.ColumnDefinitions><ColumnDefinition Width="82" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding L[Width]}" Classes="label" />
              <Grid Grid.Column="1"><TextBox x:Name="WidthBox" AutomationProperties.AutomationId="WidthBox" Text="{Binding Width, Mode=TwoWay}" /></Grid>
            </Grid>
            <Grid Width="252" Margin="0,0,12,6">
              <Grid.ColumnDefinitions><ColumnDefinition Width="82" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding L[Height]}" Classes="label" />
              <Grid Grid.Column="1"><TextBox x:Name="HeightBox" AutomationProperties.AutomationId="HeightBox" Text="{Binding Height, Mode=TwoWay}" /></Grid>
            </Grid>
            <Grid Width="252" Margin="0,0,12,6">
              <Grid.ColumnDefinitions><ColumnDefinition Width="82" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding L[FPS]}" Classes="label" />
              <Grid Grid.Column="1"><TextBox x:Name="FpsBox" AutomationProperties.AutomationId="FpsBox"
                     Text="{Binding FramePerSecond, Mode=TwoWay}" /></Grid>
            </Grid>
            <Grid Width="252" Margin="0,0,12,6">
              <Grid.ColumnDefinitions><ColumnDefinition Width="82" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding L[Codec]}" Classes="label" />
              <Grid Grid.Column="1">
              <AutoCompleteBox x:Name="CodecBox" AutomationProperties.AutomationId="CodecBox" MinWidth="0" Padding="4,3,30,3"
                      MinimumPrefixLength="0" FilterMode="None" IsTextCompletionEnabled="False" ItemsSource="{Binding CodecChoices}" ToolTip.Tip="{Binding L[Codec.Tooltip]}"
                      Text="{Binding Codec, Mode=TwoWay}" />
              <Button AutomationProperties.AutomationId="CodecDropDownButton" AutomationProperties.Name="{Binding L[Codec]}"
                      Width="28" MinWidth="0" Height="30" MinHeight="0" Margin="1" Padding="0"
                      HorizontalAlignment="Right" VerticalAlignment="Center" Focusable="False"
                      Background="Transparent" BorderThickness="0" Click="OnCodecDropDown" ToolTip.Tip="{Binding L[Codec.Tooltip]}">
                <Path Data="M 0 0 L 4 4 L 8 0" Stroke="{StaticResource TextPrimary}" StrokeThickness="1.5"
                      Width="8" Height="4" />
              </Button></Grid>
            </Grid>
            <Grid Width="252" Margin="0,0,12,6">
              <Grid.ColumnDefinitions><ColumnDefinition Width="82" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding L[Preset]}" Classes="label" />
              <Grid Grid.Column="1"><ComboBox HorizontalAlignment="Stretch" x:Name="PresetBox" AutomationProperties.AutomationId="PresetBox"
                      ItemsSource="{Binding PresetChoices}" IsEnabled="{Binding CanSelectPreset}"
                      ToolTip.Tip="{Binding L[Preset.Tooltip]}"
                      SelectedItem="{Binding CodecPreset, Mode=TwoWay}" /></Grid>
            </Grid>
            </WrapPanel>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding L[Output]}" Classes="label" />
            <TextBox x:Name="OutputBox" AutomationProperties.AutomationId="OutputBox" Grid.Row="1" Grid.Column="1" Text="{Binding OutputDir, Mode=TwoWay}" Margin="0,6,6,0" />
            <Button Grid.Row="1" Grid.Column="2" AutomationProperties.AutomationId="OpenOutputButton" Content="{Binding L[OpenOutput]}" HorizontalAlignment="Stretch"
                    Click="OnOpenOutputDir" Margin="0,6,6,0" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="FFmpeg" Classes="label" />
            <TextBox x:Name="FfmpegPathBox" AutomationProperties.AutomationId="FfmpegPathBox" Grid.Row="2" Grid.Column="1"
                     IsReadOnly="True" Text="{Binding FfmpegPath}" PlaceholderText="{Binding L[Ffmpeg.Builtin]}" ToolTip.Tip="{Binding L[Ffmpeg.Tooltip]}" Margin="0,6,6,0" />
            <WrapPanel Grid.Row="2" Grid.Column="2" IsEnabled="{Binding CanChangeFfmpeg}" Margin="0,6,6,0">
              <Button AutomationProperties.AutomationId="BrowseFfmpegButton" Content="{Binding L[Browse]}" Click="OnBrowseFfmpeg" HorizontalAlignment="Stretch" />
              <Button AutomationProperties.AutomationId="ResetFfmpegButton" Content="{Binding L[Ffmpeg.Reset]}" Click="OnResetFfmpeg" HorizontalAlignment="Stretch" />
            </WrapPanel>
          </Grid>
        </Border>

        <!-- Log -->
        <Border Grid.Row="2" MinHeight="120" Background="#FF141414" BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="1" CornerRadius="4" Margin="0,8,0,0">
          <ListBox x:Name="LogBox" AutomationProperties.AutomationId="LogBox" Background="Transparent" BorderThickness="0" Foreground="#FFCFCFCF"
                   FontFamily="Consolas" FontSize="12"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto"
                   ItemsSource="{Binding LogLines}" />
        </Border>

      </Grid>
    </ScrollViewer>

    <!-- Progress -->
    <Grid Grid.Row="2" Margin="0,8,0,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <ProgressBar Grid.Column="0" Height="18" Minimum="0" Maximum="100" Value="{Binding Progress}" />
      <TextBlock Grid.Row="1" Margin="0,4,0,0" VerticalAlignment="Center"
                 Text="{Binding ProgressText}" TextWrapping="Wrap" />
    </Grid>

    <!-- Actions -->
    <Grid Grid.Row="3" RowDefinitions="Auto,Auto" Margin="0,10,0,0">
      <WrapPanel>
      <Button x:Name="RenderButton" AutomationProperties.AutomationId="RenderButton" Content="{Binding L[Render]}" Click="OnRender" IsEnabled="{Binding CanRender}" FontWeight="SemiBold" />
      <Button x:Name="JudgeOnlyButton" AutomationProperties.AutomationId="JudgeOnlyButton" Content="{Binding L[JudgeOnly]}" Click="OnJudgeOnly" IsEnabled="{Binding CanRender}"
              ToolTip.Tip="{Binding L[JudgeOnly.Tooltip]}" />
      <Button x:Name="CancelButton" AutomationProperties.AutomationId="CancelButton" Content="{Binding L[Cancel]}" Click="OnCancel" IsEnabled="{Binding IsBusy}" />
      </WrapPanel>
      <TextBlock x:Name="ResultText" AutomationProperties.AutomationId="ResultText" Grid.Row="1" VerticalAlignment="Center" Margin="0,4,0,0"
                 Text="{Binding ResultText}" TextTrimming="CharacterEllipsis" />
    </Grid>
  </Grid>
</Window>
