<atom:Window x:Class="ManiaReplayMaster.Desktop.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:atom="https://atomui.net"
        xmlns:vm="using:ManiaReplayMaster.Presentation"
        xmlns:controls="using:ManiaReplayMaster.Desktop.Controls"
        x:DataType="vm:MainViewModel" x:CompileBindings="True"
        Title="Mania Replay Viewer" Height="620" Width="900"
        MinHeight="320" MinWidth="480"
        WindowStartupLocation="CenterScreen"
        FontFamily="{atom:SharedTokenResource FontFamily}" FontSize="{atom:SharedTokenResource FontSize}" UseLayoutRounding="True"
        DragDrop.AllowDrop="True"
        Background="{atom:SharedTokenResource ColorBgLayout}"
        Foreground="{atom:SharedTokenResource ColorText}">

  <atom:Window.Styles>
    <Style Selector="atom|Window.narrow controls|FormRow">
      <Setter Property="IsStacked" Value="True" />
    </Style>
  </atom:Window.Styles>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header + game status -->
    <WrapPanel Grid.Row="0">
      <TextBlock Text="Mania Replay Viewer" FontSize="16" FontWeight="Bold" Margin="0,0,16,6" VerticalAlignment="Center" />
      <WrapPanel VerticalAlignment="Center">
        <TextBlock Text="{Binding L[Language.Label]}" Classes="label" Margin="0,0,8,0" />
        <atom:ComboBox x:Name="LanguageBox" AutomationProperties.AutomationId="LanguageBox" Width="120" Margin="0,0,12,6"
                  SelectedIndex="0"
                  atom:ToolTip.Tip="{Binding L[Language.Tooltip]}">
          <atom:ComboBoxItem Tag="auto" Content="{Binding L[Language.System]}" />
          <atom:ComboBoxItem Tag="zh-Hans" Content="中文" />
          <atom:ComboBoxItem Tag="en" Content="English" />
        </atom:ComboBox>
        <Border Background="{atom:SharedTokenResource ColorFillTertiary}" BorderBrush="{atom:SharedTokenResource ColorBorder}"
                BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,0,6" MinHeight="28">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="7" Height="7" Fill="{Binding GamePillBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
            <TextBlock x:Name="GameStatusLabel" AutomationProperties.AutomationId="GameStatusLabel" Text="{Binding GameStatusText}" FontSize="12" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
      </WrapPanel>
    </WrapPanel>

    <atom:ScrollViewer x:Name="ContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <Grid x:Name="ContentGrid">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Inputs -->
        <Border x:Name="InputsPanel" Grid.Row="0" Background="{atom:SharedTokenResource ColorBgContainer}" BorderBrush="{atom:SharedTokenResource ColorBorderSecondary}"
                BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,4,0,0">
          <StackPanel Spacing="8">
            <controls:FormRow>
              <TextBlock Text="{Binding L[Replay.Label]}" Classes="label" />
              <atom:LineEdit x:Name="ReplayBox" AutomationProperties.AutomationId="ReplayBox"
                       Margin="0,0,6,0" Text="{Binding ReplayPath, Mode=TwoWay}" atom:ToolTip.Tip="{Binding ReplayPath}" />
              <StackPanel Orientation="Horizontal">
                <atom:Button x:Name="BrowseReplayButton" AutomationProperties.AutomationId="BrowseReplayButton" Content="{Binding L[Browse]}" Click="OnBrowseReplay" />
                <atom:Button AutomationProperties.AutomationId="LocateButton" Content="{Binding L[Locate]}" Click="OnLocateFromReplay" Margin="0"
                        atom:ToolTip.Tip="{Binding L[Locate.Tooltip]}" />
              </StackPanel>
            </controls:FormRow>
            <controls:FormRow>
              <TextBlock Text="{Binding L[Beatmap.Label]}" Classes="label" />
              <atom:LineEdit x:Name="BeatmapBox" AutomationProperties.AutomationId="BeatmapBox"
                       Margin="0,0,6,0" Text="{Binding BeatmapPath, Mode=TwoWay}" atom:ToolTip.Tip="{Binding BeatmapPath}" />
              <StackPanel Orientation="Horizontal">
                <atom:Button x:Name="BrowseBeatmapButton" AutomationProperties.AutomationId="BrowseBeatmapButton" Content="{Binding L[Browse]}" Click="OnBrowseBeatmap" />
                <atom:Button AutomationProperties.AutomationId="SwapButton" Content="{Binding L[Swap]}" Click="OnSwapPaths" Margin="0"
                        atom:ToolTip.Tip="{Binding L[Swap.Tooltip]}" />
              </StackPanel>
            </controls:FormRow>
            <controls:FormRow StackActions="True">
              <TextBlock Text="{Binding L[DetectedScore.Label]}" Classes="label" />
              <TextBlock Text="{Binding DetectedScoreText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                         atom:ToolTip.Tip="{Binding DetectedScoreText}" />
              <atom:ComboBox x:Name="ScoreCandidateBox" AutomationProperties.AutomationId="ScoreCandidateBox"
                        MinWidth="0" HorizontalAlignment="Stretch"
                        SelectionChanged="OnCandidateSelected" atom:ToolTip.Tip="{Binding L[Candidates.Tooltip]}">
                <atom:ComboBox.ItemTemplate><DataTemplate x:DataType="vm:CandidateItem"><TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" /></DataTemplate></atom:ComboBox.ItemTemplate>
              </atom:ComboBox>
            </controls:FormRow>

            <WrapPanel Margin="0,2,0,0">
              <atom:CheckBox x:Name="AutoDetectToggle" AutomationProperties.AutomationId="AutoDetectToggle" Content="{Binding L[AutoDetect]}" IsChecked="{Binding AutoDetectFromGame, Mode=TwoWay}"
                        atom:ToolTip.Tip="{Binding L[AutoDetect.Tooltip]}" />
              <atom:CheckBox Content="{Binding L[AutoStart]}" IsChecked="{Binding AutoStartRender, Mode=TwoWay}"
                        atom:ToolTip.Tip="{Binding L[AutoStart.Tooltip]}" />
              <atom:CheckBox Content="{Binding L[ReadMemory]}" IsChecked="{Binding MemoryEnabled, Mode=TwoWay}"
                        atom:ToolTip.Tip="{Binding L[ReadMemory.Tooltip]}" />
              <atom:CheckBox Content="{Binding L[DebugLogging]}" IsChecked="{Binding DebugLogging, Mode=TwoWay}" />
            </WrapPanel>
          </StackPanel>
        </Border>

        <!-- Parameters -->
        <Border x:Name="ParametersPanel" Grid.Row="1" Background="{atom:SharedTokenResource ColorBgContainer}" BorderBrush="{atom:SharedTokenResource ColorBorderSecondary}"
                BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,8,0,0">
          <StackPanel Spacing="8">
            <controls:AdaptiveGrid x:Name="ParameterFields">
              <Grid ColumnDefinitions="76,*">
                <TextBlock Text="{Binding L[Speed]}" Classes="label" />
                <Grid Grid.Column="1"><atom:Slider Margin="0,0,32,0" x:Name="SpeedSlider" AutomationProperties.AutomationId="SpeedSlider" Minimum="1" Maximum="100"
                        IsSnapToTickEnabled="True" TickFrequency="1" atom:ToolTip.Tip="{Binding L[Speed.Tooltip]}"
                        Value="{Binding Speed, Mode=TwoWay}" />
                  <TextBlock Text="{Binding Speed}" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
              </Grid>
              <Grid ColumnDefinitions="76,*">
                <TextBlock Text="{Binding L[Width]}" Classes="label" />
                <Grid Grid.Column="1"><atom:LineEdit x:Name="WidthBox" AutomationProperties.AutomationId="WidthBox" Text="{Binding Width, Mode=TwoWay}" /></Grid>
              </Grid>
              <Grid ColumnDefinitions="76,*">
                <TextBlock Text="{Binding L[Height]}" Classes="label" />
                <Grid Grid.Column="1"><atom:LineEdit x:Name="HeightBox" AutomationProperties.AutomationId="HeightBox" Text="{Binding Height, Mode=TwoWay}" /></Grid>
              </Grid>
              <Grid ColumnDefinitions="76,*">
                <TextBlock Text="{Binding L[FPS]}" Classes="label" />
                <Grid Grid.Column="1"><atom:LineEdit x:Name="FpsBox" AutomationProperties.AutomationId="FpsBox"
                       Text="{Binding FramePerSecond, Mode=TwoWay}" /></Grid>
              </Grid>
              <Grid ColumnDefinitions="76,*">
                <TextBlock Text="{Binding L[Codec]}" Classes="label" />
                <Grid Grid.Column="1">
                <atom:AutoComplete x:Name="CodecBox" AutomationProperties.AutomationId="CodecBox" MinWidth="0"
                        MinimumPrefixLength="0" IsCompletionEnabled="False"
                        atom:ToolTip.Tip="{Binding L[Codec.Tooltip]}" Value="{Binding Codec, Mode=TwoWay}">
                  <atom:AutoComplete.ContentRightAddOn>
                    <atom:Button AutomationProperties.AutomationId="CodecDropDownButton" AutomationProperties.Name="{Binding L[Codec]}"
                                 ButtonType="Text" Width="22" MinWidth="0" Height="22" MinHeight="0" Margin="0" Padding="0"
                                 Focusable="False" Click="OnCodecDropDown" atom:ToolTip.Tip="{Binding L[Codec.Tooltip]}">
                      <Path Data="M 0 0 L 4 4 L 8 0" Stroke="{atom:SharedTokenResource ColorTextSecondary}" StrokeThickness="1.5"
                            Width="8" Height="4" />
                    </atom:Button>
                  </atom:AutoComplete.ContentRightAddOn>
                </atom:AutoComplete>
                </Grid>
              </Grid>
              <Grid ColumnDefinitions="76,*">
                <TextBlock Text="{Binding L[Preset]}" Classes="label" />
                <Grid Grid.Column="1"><atom:ComboBox HorizontalAlignment="Stretch" x:Name="PresetBox" AutomationProperties.AutomationId="PresetBox"
                        ItemsSource="{Binding PresetChoices}" IsEnabled="{Binding CanSelectPreset}"
                        atom:ToolTip.Tip="{Binding L[Preset.Tooltip]}"
                        SelectedItem="{Binding CodecPreset, Mode=TwoWay}" /></Grid>
              </Grid>
            </controls:AdaptiveGrid>
            <controls:FormRow>
              <TextBlock Text="{Binding L[Output]}" Classes="label" />
              <atom:LineEdit x:Name="OutputBox" AutomationProperties.AutomationId="OutputBox" Margin="0,0,6,0" Text="{Binding OutputDir, Mode=TwoWay}" atom:ToolTip.Tip="{Binding OutputDir}" />
              <StackPanel Orientation="Horizontal">
                <atom:Button AutomationProperties.AutomationId="OpenOutputButton" Content="{Binding L[OpenOutput]}" Click="OnOpenOutputDir" Margin="0" />
              </StackPanel>
            </controls:FormRow>
            <controls:FormRow>
              <TextBlock Text="FFmpeg" Classes="label" />
              <atom:LineEdit x:Name="FfmpegPathBox" AutomationProperties.AutomationId="FfmpegPathBox" IsReadOnly="True"
                       Margin="0,0,6,0" Text="{Binding FfmpegPath}" PlaceholderText="{Binding L[Ffmpeg.Builtin]}" atom:ToolTip.Tip="{Binding L[Ffmpeg.Tooltip]}" />
              <StackPanel Orientation="Horizontal" IsEnabled="{Binding CanChangeFfmpeg}">
                <atom:Button AutomationProperties.AutomationId="BrowseFfmpegButton" Content="{Binding L[Browse]}" Click="OnBrowseFfmpeg" />
                <atom:Button AutomationProperties.AutomationId="ResetFfmpegButton" Content="{Binding L[Ffmpeg.Reset]}" Click="OnResetFfmpeg" Margin="0" />
              </StackPanel>
            </controls:FormRow>
          </StackPanel>
        </Border>

        <!-- Log -->
        <Border x:Name="LogPanel" Grid.Row="2" MinHeight="96" Background="{atom:SharedTokenResource ColorBgContainer}" BorderBrush="{atom:SharedTokenResource ColorBorderSecondary}"
                BorderThickness="1" CornerRadius="6" Margin="0,8,0,0">
          <atom:ListBox x:Name="LogBox" AutomationProperties.AutomationId="LogBox" Background="Transparent" BorderThickness="0" Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                   FontFamily="Consolas" FontSize="12"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto"
                   ItemsSource="{Binding LogLines}" />
        </Border>

      </Grid>
    </atom:ScrollViewer>

    <!-- Progress -->
    <Grid Grid.Row="2" Margin="0,8,0,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <atom:ProgressBar Grid.Column="0" IndicatorThickness="6" IsProgressInfoVisible="False" Minimum="0" Maximum="100" Value="{Binding Progress}" />
      <TextBlock Grid.Row="1" Margin="0,4,0,0" VerticalAlignment="Center"
                 Text="{Binding ProgressText}" TextTrimming="CharacterEllipsis" atom:ToolTip.Tip="{Binding ProgressText}" />
    </Grid>

    <!-- Actions -->
    <Grid Grid.Row="3" RowDefinitions="Auto,Auto" Margin="0,8,0,0">
      <WrapPanel>
      <atom:Button x:Name="RenderButton" ButtonType="Primary" AutomationProperties.AutomationId="RenderButton" Content="{Binding L[Render]}" Click="OnRender" IsEnabled="{Binding CanRender}" FontWeight="SemiBold" />
      <atom:Button x:Name="JudgeOnlyButton" AutomationProperties.AutomationId="JudgeOnlyButton" Content="{Binding L[JudgeOnly]}" Click="OnJudgeOnly" IsEnabled="{Binding CanRender}"
              atom:ToolTip.Tip="{Binding L[JudgeOnly.Tooltip]}" />
      <atom:Button x:Name="CancelButton" AutomationProperties.AutomationId="CancelButton" Content="{Binding L[Cancel]}" Click="OnCancel" IsEnabled="{Binding IsBusy}" />
      </WrapPanel>
      <TextBlock x:Name="ResultText" AutomationProperties.AutomationId="ResultText" Grid.Row="1" VerticalAlignment="Center" Margin="0,4,0,0"
                 Text="{Binding ResultText}" TextTrimming="CharacterEllipsis" />
    </Grid>
  </Grid>
</atom:Window>
