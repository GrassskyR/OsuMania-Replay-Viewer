# ---------------------------------------------------------------------------------------------
# Line-ending and binary policy.
#
# The build machine has core.autocrlf=true, so text is stored with LF and checked out with CRLF.
# Binaries are declared EXPLICITLY here because git only auto-detects binary by looking for a NUL byte
# in the first 8 KB: a small package or fixture without one would be treated as text, get its line
# endings rewritten, and silently corrupt the committed offline NuGet feed (packages/) or a replay
# fixture (LZMA payload where every byte matters).
# ---------------------------------------------------------------------------------------------

* text=auto

# Never touch these bytes
*.nupkg binary
*.png   binary
*.osr   binary
*.osg   binary
*.zip   binary
*.dll   binary
*.exe   binary
*.pfx   binary

# Windows scripts keep CRLF on checkout
*.ps1 text eol=crlf
*.cmd text eol=crlf

# Source, docs and reference data are text
*.cs     text
*.xaml   text
*.csproj text
*.sln    text
*.props  text
*.json   text
*.md     text
*.py     text
*.osu    text
