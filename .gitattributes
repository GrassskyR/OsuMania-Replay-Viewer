# Preserve binary replay fixtures and use CRLF for Windows scripts.
* text=auto

# Never touch these bytes
*.png   binary
*.osr   binary
*.osg   binary
*.zip   binary
*.dll   binary
*.exe   binary
*.pfx   binary

# Windows scripts keep CRLF on checkout
*.ps1 text eol=crlf

# Source, docs and reference data are text
*.cs     text
*.xaml   text
*.csproj text
*.sln    text
*.props  text
*.json   text
*.md     text
*.osu    text
